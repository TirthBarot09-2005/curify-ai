# Curify AI — Frontend Environment Variables

# Clerk Authentication (Get from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: If you have an official CARTO Basemaps API key, add it below.
# If left blank, Curify AI automatically uses OpenStreetMap tiles (100% free, no API key required).
VITE_CARTO_API_KEY=

# Optional: Custom map tile provider template URL
# Example: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILES_URL=

# Backend API Base URL (Leave empty in local dev to use Vite proxy /api; Set to https://your-backend.com/api in production)
VITE_API_URL=
