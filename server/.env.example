# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/curify
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=curify

# Clerk Authentication (Configured in dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=4000
AI_CACHE_ENABLED=true
AI_DAILY_LIMIT=3
